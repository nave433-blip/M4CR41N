// M4CR41N tests — device module (pure parts).
import "../lib/core.nvs"
import "../lib/device.nvs"
import "../lib/modes.nvs"

fn t_is_udid() {
  assert(is_udid("000080300000000000000000") == true, "24-hex UDID")
  assert(is_udid("00008030-001234567890ABCD") == true, "dashes allowed")
  assert(is_udid("00008030000000000000000e") == true, "lowercase hex")
  assert(is_udid("ERROR: Unable to retrieve device list!") == false, "error text rejected")
  assert(is_udid("") == false, "empty rejected")
  assert(is_udid("short") == false, "short rejected")
  assert(is_udid("00008030ZZZZ000000000000") == false, "non-hex rejected")
}

fn t_ideviceinfo_fixture() {
  let txt = read_file("../tests/fixtures/ideviceinfo.txt")
  let h = parse_kv(txt)
  assert(h["ProductType"] == "iPhone10,1", "fixture ProductType")
  assert(h["ProductVersion"] == "16.7.16", "fixture ProductVersion")
  assert(h["DeviceName"] == "Evan's iPhone", "fixture DeviceName")
  assert(h["TimeZone"] == "America/Indiana/Indianapolis", "fixture value with slashes")
}

fn t_battery_summary() {
  let sample = "CycleCount: 412\nDesignCapacity: 3200\nFullChargeCapacity: 2871\nBatteryCurrentCapacity: 82\nBatteryIsCharging: false\nSerialNumber: F17XK0ABCDEF\nSomeOtherKey: hello"
  let hits = battery_summary_lines(sample)
  assert(len(hits) == 5, "5 battery lines matched, got " + str(len(hits)))
  assert(hits[0] == "CycleCount: 412", "first hit is CycleCount")
  assert(len(battery_summary_lines("NoBatteryHere: 1\nFoo: bar")) == 0, "no matches -> empty")
  assert(len(battery_summary_lines("")) == 0, "empty input -> empty")
}

fn t_norm_pid_device() {
  // end-to-end: macOS-style raw PID normalizes before classification
  assert(classify_pid(norm_pid("0x1227")) == "DFU MODE", "macOS DFU pid path")
}

t_is_udid()
t_ideviceinfo_fixture()
t_battery_summary()
t_norm_pid_device()
print "test_device OK"
