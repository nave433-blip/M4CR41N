// M4CR41N modes module — recovery mode and DFU mode helpers.
// Recovery enter/exit via libimobiledevice. DFU cannot be entered in
// software on modern devices, so we DETECT it and print guided entry
// steps per device family (honest — no fake "software DFU entry").

// Known Apple USB product IDs for DFU / recovery / restore modes.
let DFU_PIDS = ["1227"]                    // 05ac:1227 DFU mode
let RECOVERY_PIDS = ["1281", "1280"]       // 05ac:1281/1280 recovery mode

// classify_pid(pid): USB product-ID -> mode label (pure, testable).
fn classify_pid(pid) {
  if (pid == "1227") {
    return "DFU MODE"
  }
  if (pid == "1281" || pid == "1280") {
    return "RECOVERY MODE"
  }
  return "normal/other (pid " + pid + ")"
}

fn dfu_detect() {
  m_info("scanning USB for Apple DFU/recovery devices (05ac:1227 / 05ac:1281)...")
  let devs = usb_apple_devices()
  let hits = []
  for (d in devs) {
    push(hits, [classify_pid(d["pid"]), d["desc"]])
  }
  if (len(hits) == 0) {
    m_warn("no Apple USB device found.")
    return false
  }
  for (h in hits) { print "  [" + h[0] + "] " + h[1] }
  return true
}

// dfu_guide(model): print button-combo steps for entering DFU.
fn dfu_guide(model) {
  print ""
  print "== Entering DFU mode (hardware button combo — no software shortcut) =="
  print ""
  print "iPhone 8 and later / iPad with Face ID:"
  print "  1. Connect to computer, open " + (M_IS_MAC ? "Finder" : "iTunes/Finder") + "."
  print "  2. Press Volume Up, release. Press Volume Down, release."
  print "  3. Hold Side button 10 seconds until screen goes black."
  print "  4. Hold Side + Volume Down 5 seconds, release Side, keep"
  print "     holding Volume Down 10 more seconds. Screen stays BLACK"
  print "     (Apple logo = recovery mode, start over)."
  print ""
  print "iPhone 7 / 7 Plus:"
  print "  1. Hold Side + Volume Down 8 seconds, release Side,"
  print "     keep holding Volume Down until computer detects DFU."
  print ""
  print "iPhone 6s and earlier / iPad with Home button:"
  print "  1. Hold Home + Sleep/Wake 8 seconds, release Sleep/Wake,"
  print "     keep holding Home until computer detects DFU."
  print ""
  print "Verify with:  m4cr41n dfu detect   (look for 05ac:1227)"
  print "Exit DFU: force-restart the device (button combo for your model)."
}

// recovery_enter(udid): reboot a booted device into recovery mode.
fn recovery_enter(udid) {
  if (!require_tool("ideviceenterrecovery")) {
    return false
  }
  let cmd = "ideviceenterrecovery"
  if (udid != null && udid != "") {
    cmd = cmd + " " + udid
  }
  m_warn("sending device to recovery mode...")
  let r = sh_ok(cmd)
  if (r[1]) {
    m_ok("device entering recovery mode.")
  }
  else {
    m_err("failed: " + r[0])
  }
  return r[1]
}

// recovery_exit(): reboot a device out of recovery mode via irecovery.
fn recovery_exit() {
  if (!require_tool("irecovery")) {
    return false
  }
  m_info("sending reboot command via irecovery...")
  let r = sh_ok("irecovery -n")
  if (r[1]) {
    m_ok("reboot command sent.")
  }
  else {
    // older irecovery builds: try explicit command form
    let r2 = sh_ok("irecovery -c reboot")
    if (r2[1]) {
      m_ok("reboot command sent.")
    }
    else {
      m_err("irecovery failed: " + r2[0])
      return false
    }
  }
  return true
}
