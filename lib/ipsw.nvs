// M4CR41N ipsw module — Apple firmware metadata via the public ipsw.me API.
// API: https://api.ipsw.me/v4/devices and /v4/device/<identifier>
// (community API over Apple's own CDN links; URLs point at Apple servers).

let IPSW_API = "https://api.ipsw.me/v4"

// ipsw_devices(): [{identifier, name}, ...]
fn ipsw_devices() {
  let raw = http_get(IPSW_API + "/devices")
  if (raw == "" || raw == null) {
    m_err("ipsw.me API unreachable.")
    return []
  }
  let arr = json_parse(raw)
  let out = []
  for (d in arr) { push(out, {"identifier": d["identifier"], "name": d["name"]}) }
  return out
}

// ipsw_firmwares(identifier): raw firmware list for a device.
fn ipsw_firmwares(identifier) {
  let raw = http_get(IPSW_API + "/device/" + identifier)
  if (raw == "" || raw == null) {
    m_err("ipsw.me API unreachable or unknown identifier '" + identifier + "'.")
    return []
  }
  let doc = json_parse(raw)
  if (doc["firmwares"] == null) {
    return []
  }
  return doc["firmwares"]
}

// ipsw_signed(firmwares): filter to currently-signed builds.
fn ipsw_signed(firmwares) {
  let out = []
  for (f in firmwares) {
    if (f["signed"] == true) {
      push(out, f)
    }
  }
  return out
}

// ipsw_print_table(firmwares): human-readable firmware list.
fn ipsw_print_table(firmwares) {
  if (len(firmwares) == 0) {
    m_warn("no firmwares found.")
    return null
  }
  for (f in firmwares) {
    let tag = f["signed"] == true ? "[SIGNED]  " : "[unsigned]"
    print tag + " iOS " + str(f["version"]) + " (" + str(f["buildid"]) + ")  " + str(f["url"])
  }
}

// ipsw_match_device(devs, name): fuzzy match a product name against a
// device list -> identifier or null. Case-insensitive. Pure, testable.
fn ipsw_match_device(devs, name) {
  let needle = lower(trim(name))
  if (needle == "") {
    return null
  }
  for (d in devs) {
    let nm = d["name"]
    let id = d["identifier"]
    if (nm == null) { nm = "" }
    if (id == null) { id = "" }
    if (contains(lower(nm), needle) || contains(lower(id), needle)) {
      return d["identifier"]
    }
  }
  return null
}

// ipsw_lookup_device(name): fuzzy match a product name -> identifier.
fn ipsw_lookup_device(name) {
  let devs = ipsw_devices()
  return ipsw_match_device(devs, name)
}
