fn tool_hint(tool) {
  if (TOOL_HINTS[tool] == null) {
    return "no install hint recorded for " + tool
  }
  let per = TOOL_HINTS[tool]
  if (M_IS_MAC && per["darwin"] != null) {
    return per["darwin"]
  }
  if (M_IS_WIN && per["windows"] != null) {
    return per["windows"]
  }
  if (M_IS_LINUX && per["linux"] != null) {
    return per["linux"]
  }
  return per["darwin"]
}

// require_tool(tool): true if present, else prints hint and returns false.
fn require_tool(tool) {
  if (have(tool)) {
    return true
  }
  m_warn("'" + tool + "' not found on PATH.")
  m_info("install: " + tool_hint(tool))
  return false
}
