// M4CR41N core library — shared helpers for every tool module.
// Imported by m4cr41n.nvs and by the test suite. No side effects on import.

// ---- platform -----------------------------------------------------------
// Detect OS via shell so this works on any nvs runtime (old or new).
fn detect_os() {
  let u = system("uname -s 2>/dev/null")
  // system() appends "\n[exit error: ...]" on failure — check the raw text.
  if (contains(u, "Darwin")) {
    return "darwin"
  }
  if (contains(u, "Linux")) {
    return "linux"
  }
  let w = system("ver 2>nul")
  if (contains(w, "Windows")) {
    return "windows"
  }
  return "unknown"
}

let M_OS = detect_os()            // "darwin" | "linux" | "windows" | ...
let M_IS_MAC = M_OS == "darwin"
let M_IS_WIN = M_OS == "windows"
let M_IS_LINUX = M_OS == "linux"

fn m_os_label() {
  if (M_IS_MAC) {
    return "macOS"
  }
  if (M_IS_WIN) {
    return "Windows"
  }
  if (M_IS_LINUX) {
    return "Linux"
  }
  return M_OS
}

// ---- shell --------------------------------------------------------------
// have(cmd): true when an executable is on PATH.
fn have(cmd) {
  let probe = ""
  if (M_IS_WIN) {
    probe = "where " + cmd + " 2>nul"
  } else {
    probe = "command -v " + cmd + " >/dev/null 2>&1 && echo yes"
  }
  let out = system(probe)
  return contains(out, cmd) || contains(out, "yes")
}

// sh(cmd): run a shell command, return stdout ("" on failure). Never throws.
fn sh(cmd) {
  let out = system(cmd)
  // system() appends "\n[exit error: ...]" on nonzero exit — strip it.
  let marker = "[exit error:"
  let idx = index_of(out, marker)
  if (idx >= 0) {
    return trim(out[0:idx])
  }
  return trim(out)
}

// sh_ok(cmd): [output, success_bool]
fn sh_ok(cmd) {
  let out = system(cmd)
  let marker = "[exit error:"
  let idx = index_of(out, marker)
  if (idx >= 0) {
    return [trim(out[0:idx]), false]
  }
  return [trim(out), true]
}

// norm_pid(pid): normalize a USB product ID for comparison — strip a
// leading "0x" (macOS system_profiler format) and lowercase. Pure.
fn norm_pid(pid) {
  let p = trim(pid)
  if (starts_with(p, "0x") || starts_with(p, "0X")) {
    p = p[2:len(p)]
  }
  return lower(p)
}

// shell_quote(s): wrap a string in single quotes for safe embedding in
// shell commands — escapes embedded single quotes. Pure.
fn shell_quote(s) {
  let out = "'"
  let i = 0
  while (i < len(s)) {
    let c = s[i]
    if (c == "'") {
      out = out + "'\\''"
    } else {
      out = out + c
    }
    i = i + 1
  }
  return out + "'"
}

// is_safe_nvram_name(name): variable names may only contain alphanumerics
// plus - _ % : — anything else is rejected before touching the shell.
fn is_safe_nvram_name(name) {
  if (name == null || trim(name) == "") {
    return false
  }
  let i = 0
  while (i < len(name)) {
    let c = name[i]
    let okc = (c >= "a" && c <= "z") || (c >= "A" && c <= "Z") ||
              (c >= "0" && c <= "9") || c == "-" || c == "_" || c == "%" || c == ":"
    if (!okc) {
      return false
    }
    i = i + 1
  }
  return true
}

// ---- output -------------------------------------------------------------
fn m_info(msg)  { print "[*] " + msg }
fn m_ok(msg)    { print "[+] " + msg }
fn m_warn(msg)  { print "[!] " + msg }
fn m_err(msg)   { eprint "[x] " + msg }

fn m_die(msg, code) {
  m_err(msg)
  if (code == null) {
    code = 1
  }
  exit(code)
}

// ---- parsing ------------------------------------------------------------
// parse_kv(text): "Key: value" lines -> hash. Used for ideviceinfo, nvram -p, etc.
fn parse_kv(text) {
  let h = {}
  let lines = split(text, "\n")
  for (line in lines) {
    let i = index_of(line, ":")
    if (i > 0) {
      let k = trim(line[0:i])
      let v = trim(line[i+1:len(line)])
      h[k] = v
    }
  }
  return h
}

// table(rows): print aligned two-column rows: [[k, v], ...]
fn m_table(rows) {
  let w = 0
  for (r in rows) { if (len(r[0]) > w) { w = len(r[0]) } }
  for (r in rows) {
    let pad = ""
    let n = w - len(r[0]) + 2
    let i = 0
    while (i < n) {
      pad = pad + " "
      i = i + 1
    }
    print "  " + r[0] + pad + r[1]
  }
}

// ---- command suggestions ------------------------------------------------
// str_dist(a, b): Levenshtein edit distance between two strings. Pure.
fn str_dist(a, b) {
  let m = len(a)
  let n = len(b)
  if (m == 0) {
    return n
  }
  if (n == 0) {
    return m
  }
  let prev = []
  let j = 0
  while (j <= n) {
    push(prev, j)
    j = j + 1
  }
  let i = 1
  while (i <= m) {
    let cur = [i]
    j = 1
    while (j <= n) {
      let cost = 1
      if (a[i-1] == b[j-1]) {
        cost = 0
      }
      let best = prev[j] + 1
      if (cur[j-1] + 1 < best) {
        best = cur[j-1] + 1
      }
      if (prev[j-1] + cost < best) {
        best = prev[j-1] + cost
      }
      push(cur, best)
      j = j + 1
    }
    prev = cur
    i = i + 1
  }
  return prev[n]
}

let M_COMMANDS = ["doctor", "devices", "info", "battery", "recovery", "dfu",
  "nvram", "secaudit", "firmware", "jailbreak", "apps", "shot", "restart",
  "pair", "backup", "version", "help"]

// suggest_command(cmd): "did you mean?" for mistyped commands.
// Returns the closest command name within edit distance 2, else null.
fn suggest_command(cmd) {
  let best = null
  let bestd = 3
  for (c in M_COMMANDS) {
    let d = str_dist(cmd, c)
    if (d < bestd) {
      bestd = d
      best = c
    }
  }
  return best
}

