{"description":"M4CR41N workflow entry — runs the toolkit's self-check via the real NvS CLI. Equivalent to: ./m4cr41n doctor","module":"m4cr41n","steps":[{"message":"M4CR41N workflow starting — delegating to the NvS CLI (m4cr41n.nvs)","op":"log"},{"code":"import os, shutil, subprocess\nnvs = os.environ.get('NVS_RUNTIME') or shutil.which('nvs')\nresult = {'nvs': nvs, 'ran': False, 'output': ''}\nif nvs:\n    here = os.path.dirname(os.path.abspath('m4cr41n.nave'))\n    cli = os.path.join(here, 'm4cr41n.nvs')\n    if not os.path.exists(cli):\n        cli = 'm4cr41n.nvs'\n    try:\n        p = subprocess.run([nvs, 'run', cli, 'doctor'], capture_output=True, text=True, timeout=120)\n        result = {'nvs': nvs, 'ran': True, 'returncode': p.returncode, 'output': p.stdout + p.stderr}\n    except Exception as e:\n        result = {'nvs': nvs, 'ran': False, 'output': 'error: ' + str(e)}\nelse:\n    result = {'nvs': None, 'ran': False, 'output': 'nvs runtime not found on PATH (set NVS_RUNTIME)'}","lang":"python","op":"polyglot_eval","return_var":"doctor_out"},{"message":"doctor result collected","op":"log"},{"op":"answer","var":"doctor_out"}],"version":"0.3.0","world":"cli"}